                  "readOnly": true
                }
              ]
            }
          },
          {
            "name": "secondary",
            "properties": {
              "command": [
                "python3",
                "/app/secondary_aci.py"
              ],
              "environmentVariables": [
                {
                  "name": "AGENTDNS_TRANSFER_KEY_B64",
                  "secureValue": "[parameters('transferKeyB64')]"
                }
              ],
              "image": "agentdnsport20260913.azurecr.io/secondary@sha256:dfd9158f60a9a0cd67b445b001ee636a0389c66ce926af3c386588d886976861",
              "ports": [
                {
                  "port": 53,
                  "protocol": "UDP"
                }
              ],
              "resources": {
                "requests": {
                  "cpu": 2,
                  "memoryInGB": 4
                }
              }
            }
          }
        ],
        "diagnostics": {
          "logAnalytics": {
            "workspaceId": "[parameters('logAnalyticsWorkspaceId')]",
            "workspaceKey": "[parameters('logAnalyticsWorkspaceKey')]"
          }
        },
        "imageRegistryCredentials": [
          {
            "identity": "/subscriptions/1b191b4c-2968-420a-b275-5087e94bf355/resourceGroups/agentdns-port-validation-20260913/providers/Microsoft.ManagedIdentity/userAssignedIdentities/agentdns-validation-pull",
            "server": "agentdnsport20260913.azurecr.io"
