{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "durableStorageAccountKey": {
      "type": "secureString"
    },
    "logAnalyticsWorkspaceId": {
      "type": "string"
    },
    "logAnalyticsWorkspaceKey": {
      "type": "secureString"
    },
    "transferKeyB64": {
      "type": "secureString"
    },
    "transferKeyJson": {
      "type": "secureString"
    }
  },
  "resources": [
    {
      "apiVersion": "2023-05-01",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "/subscriptions/1b191b4c-2968-420a-b275-5087e94bf355/resourceGroups/agentdns-port-validation-20260913/providers/Microsoft.ManagedIdentity/userAssignedIdentities/agentdns-validation-pull": {}
        }
      },
      "location": "northeurope",
      "name": "agentdns-ccf-join-20260921-v3",
      "properties": {
        "confidentialComputeProperties": {
          "ccePolicy": ""
        },
        "containers": [
          {
            "name": "primary",
            "properties": {
              "command": [
                "python3",
                "/opt/agentdns/run.py",
                "--config",
                "/config/node.json",
                "--config-manifest",
                "/config/manifest.json",
                "--config-manifest-sha256",
                "13d4c47222b339a1465e48ac7d7709b95055d9efad19cce2f3883119d707b662",
                "--provision-tsig-file",
                "/secrets/transfer-key.json"
              ],
              "environmentVariables": [
                {
                  "name": "OTEL_SDK_DISABLED",
                  "value": "true"
                }
              ],
              "image": "agentdnsport20260913.azurecr.io/primary@sha256:f180a8a8e316ded2c8ccc7603e46bc18ded4446fafe2118f6038105fb7debcf4",
              "ports": [
                {
                  "port": 8000,
                  "protocol": "TCP"
