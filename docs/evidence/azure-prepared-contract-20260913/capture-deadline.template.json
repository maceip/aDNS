{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "captureToken": {
      "type": "secureString",
      "minLength": 64,
      "maxLength": 64
    }
  },
  "resources": [
    {
      "type": "Microsoft.ContainerInstance/containerGroups",
      "apiVersion": "2023-05-01",
      "name": "agentdns-native-capture",
      "location": "northeurope",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "/subscriptions/1b191b4c-2968-420a-b275-5087e94bf355/resourcegroups/agentdns-port-validation-20260913/providers/Microsoft.ManagedIdentity/userAssignedIdentities/agentdns-validation-pull": {}
        }
      },
      "tags": {
        "project": "agentdns",
        "purpose": "port-validation"
      },
      "properties": {
        "sku": "Confidential",
        "osType": "Linux",
        "restartPolicy": "Never",
        "imageRegistryCredentials": [
          {
            "server": "agentdnsport20260913.azurecr.io",
            "identity": "/subscriptions/1b191b4c-2968-420a-b275-5087e94bf355/resourcegroups/agentdns-port-validation-20260913/providers/Microsoft.ManagedIdentity/userAssignedIdentities/agentdns-validation-pull"
          }
        ],
        "containers": [
          {
            "name": "capture",
            "properties": {
              "image": "agentdnsport20260913.azurecr.io/capture@sha256:61027bfc59833975356d526d58557e2b18e4af76464b52acb448e3a9a5feba7a",
              "command": [
                "python3",
                "/app/capture_aci.py"
              ],
              "ports": [
                {
                  "port": 25,
                  "protocol": "TCP"
                },
                {
                  "port": 465,
                  "protocol": "TCP"
                },
                {
                  "port": 993,
                  "protocol": "TCP"
                },
                {
                  "port": 8080,
                  "protocol": "TCP"
                }
              ],
              "resources": {
                "requests": {
                  "cpu": 2,
                  "memoryInGB": 4
                }
              },
              "environmentVariables": [
                {
                  "name": "AGENTDNS_CAPTURE_CONFIG_B64",
                  "value": ""
                },
                {
                  "name": "AGENTDNS_CAPTURE_TOKEN",
                  "secureValue": "[parameters('captureToken')]"
                }
              ]
            }
          }
        ],
        "ipAddress": {
          "type": "Public",
          "ports": [
            {
              "port": 25,
              "protocol": "TCP"
            },
            {
              "port": 465,
              "protocol": "TCP"
            },
            {
              "port": 993,
              "protocol": "TCP"
            },
            {
              "port": 8080,
              "protocol": "TCP"
            }
          ]
        },
        "confidentialComputeProperties": {
          "ccePolicy": ""
        }
      }
    }
  ]
}
