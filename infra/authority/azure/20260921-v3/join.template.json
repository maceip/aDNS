        ],
        "ipAddress": {
          "dnsNameLabel": "agentdns-ccf-join-20260921-v3",
          "ports": [
            {
              "port": 8000,
              "protocol": "TCP"
            },
            {
              "port": 5353,
              "protocol": "TCP"
            },
            {
              "port": 8002,
              "protocol": "TCP"
            },
            {
              "port": 53,
              "protocol": "UDP"
            }
          ],
          "type": "Public"
        },
        "osType": "Linux",
        "restartPolicy": "Never",
        "sku": "Confidential",
        "volumes": [
          {
            "name": "public-config",
            "secret": {
              "node.json": "",
              "service_cert.pem": "",
              "manifest.json": ""
            }
          },
          {
            "name": "transfer-secret",
            "secret": {
              "transfer-key.json": "[base64(parameters('transferKeyJson'))]"
            }
          },
          {
            "emptyDir": {},
            "name": "primary-state"
          },
          {
            "azureFile": {
              "readOnly": false,
              "shareName": "ccf-join-20260921-v3",
              "storageAccountKey": "[parameters('durableStorageAccountKey')]",
              "storageAccountName": "adnsrecovery20260921"
            },
            "name": "durable-state"
          },
          {
            "name": "bootstrap-snapshots",
            "azureFile": {
              "readOnly": true,
              "shareName": "ccf-recovery-20260921-v2",
              "storageAccountKey": "[parameters('durableStorageAccountKey')]",
              "storageAccountName": "adnsrecovery20260921"
            }
          }
        ]
      },
      "tags": {
        "project": "agentdns",
        "purpose": "isolated-member-authorized-recovery"
      },
      "type": "Microsoft.ContainerInstance/containerGroups"
    }
  ],
  "metadata": {
