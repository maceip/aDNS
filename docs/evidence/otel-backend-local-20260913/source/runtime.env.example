# No credentials belong in this public example. Generate a private random password
# file in an ignored 0700 directory and set its absolute path here.
AGENTDNS_GRAFANA_PASSWORD_FILE=/absolute/private/grafana-password
OTEL_HTTP_PORT=14318
OTEL_GRPC_PORT=14317
TEMPO_HTTP_PORT=13200
GRAFANA_HTTP_PORT=13000
# Native HTTPS overlay only, after endpoint/TLS/firewall review:
# AGENTDNS_OTEL_TLS_DIRECTORY=/absolute/private/otel-tls
# AGENTDNS_OTEL_BIND_IP=127.0.0.1
# AGENTDNS_OTEL_TLS_PORT=14319
