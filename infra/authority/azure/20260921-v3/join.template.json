                {
                  "port": 5353,
                  "protocol": "TCP"
                },
                {
                  "port": 8002,
                  "protocol": "TCP"
                }
              ],
              "resources": {
                "requests": {
                  "cpu": 2,
                  "memoryInGB": 4
                }
              },
              "volumeMounts": [
                {
                  "mountPath": "/config",
                  "name": "public-config",
                  "readOnly": true
                },
                {
                  "mountPath": "/secrets",
                  "name": "transfer-secret",
                  "readOnly": true
                },
                {
                  "mountPath": "/state",
                  "name": "primary-state"
                },
                {
                  "mountPath": "/durable",
