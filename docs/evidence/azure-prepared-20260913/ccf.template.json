{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "transferKeyB64": {
      "type": "secureString"
    },
    "transferKeyJson": {
      "type": "secureString"
    }
  },
  "resources": [
    {
      "type": "Microsoft.ContainerInstance/containerGroups",
      "apiVersion": "2023-05-01",
      "name": "agentdns-ccf-validation",
      "location": "northeurope",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "/subscriptions/1b191b4c-2968-420a-b275-5087e94bf355/resourcegroups/agentdns-port-validation-20260913/providers/Microsoft.ManagedIdentity/userAssignedIdentities/agentdns-validation-pull": {}
        }
      },
      "tags": {
        "project": "agentdns",
        "purpose": "port-validation"
      },
      "properties": {
        "sku": "Confidential",
        "osType": "Linux",
        "restartPolicy": "Always",
        "imageRegistryCredentials": [
          {
            "server": "agentdnsport20260913.azurecr.io",
            "identity": "/subscriptions/1b191b4c-2968-420a-b275-5087e94bf355/resourcegroups/agentdns-port-validation-20260913/providers/Microsoft.ManagedIdentity/userAssignedIdentities/agentdns-validation-pull"
          }
        ],
        "containers": [
          {
            "name": "primary",
            "properties": {
              "image": "agentdnsport20260913.azurecr.io/primary@sha256:e19e89d475f2176fe729071151657719b618b1eeced20eb2a907467b35d5f415",
              "command": [
                "python3",
                "/opt/agentdns/run.py",
                "--config",
                "/config/node.json",
                "--config-manifest",
                "/config/manifest.json",
                "--config-manifest-sha256",
                "304fc60aa7584c3ce9e28c3abb8f8753df856b5c9cee8b62595c5cfa48d402d4",
                "--provision-tsig-file",
                "/secrets/transfer-key.json"
              ],
              "ports": [
                {
                  "port": 8000,
                  "protocol": "TCP"
                }
              ],
              "resources": {
                "requests": {
                  "cpu": 2,
                  "memoryInGB": 4
                }
              },
              "volumeMounts": [
                {
                  "name": "public-config",
                  "mountPath": "/config",
                  "readOnly": true
                },
                {
                  "name": "transfer-secret",
                  "mountPath": "/secrets",
                  "readOnly": true
                },
                {
                  "name": "primary-state",
                  "mountPath": "/state"
                }
              ]
            }
          },
          {
            "name": "secondary",
            "properties": {
              "image": "agentdnsport20260913.azurecr.io/secondary@sha256:dfd9158f60a9a0cd67b445b001ee636a0389c66ce926af3c386588d886976861",
              "command": [
                "python3",
                "/app/secondary_aci.py"
              ],
              "ports": [
                {
                  "port": 53,
                  "protocol": "TCP"
                },
                {
                  "port": 53,
                  "protocol": "UDP"
                }
              ],
              "resources": {
                "requests": {
                  "cpu": 2,
                  "memoryInGB": 4
                }
              },
              "environmentVariables": [
                {
                  "name": "AGENTDNS_TRANSFER_KEY_B64",
                  "secureValue": "[parameters('transferKeyB64')]"
                }
              ]
            }
          }
        ],
        "ipAddress": {
          "type": "Public",
          "ports": [
            {
              "port": 8000,
              "protocol": "TCP"
            },
            {
              "port": 53,
              "protocol": "TCP"
            },
            {
              "port": 53,
              "protocol": "UDP"
            }
          ]
        },
        "volumes": [
          {
            "name": "public-config",
            "secret": {
              "node.json": "",
              "manifest.json": "",
              "member0_cert.pem": "",
              "member0_enc_pubk.pem": ""
            }
          },
          {
            "name": "transfer-secret",
            "secret": {
              "transfer-key.json": "[base64(parameters('transferKeyJson'))]"
            }
          },
          {
            "name": "primary-state",
            "emptyDir": {}
          }
        ],
        "confidentialComputeProperties": {
          "ccePolicy": ""
        }
      }
    }
  ]
}
